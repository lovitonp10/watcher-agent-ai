# Tech Watch Agent - Environment Variables Template
# Copy this file to .env and fill in your actual values

# === LLM Configuration ===
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=your_groq_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# For Ollama (local)
# LLM_BASE_URL=http://localhost:11434

# === Email Configuration ===
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=recipient1@example.com, recipient2@example.com, recipient3@example.com
EMAIL_USE_TLS=true

# === Notes ===
# - Get Groq API key: https://console.groq.com/keys
# - For Gmail: Use App Password (not regular password)
#   Guide: https://support.google.com/accounts/answer/185833
# - EMAIL_TO supports multiple emails separated by commas
# - Keep this file SECRET - never commit to Git!
